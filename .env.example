APP_NAME="WeblexAI Community Edition"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8787
APP_INSTALLED=false
APP_VERSION=latest
APP_PORT=8787
WEBLEX_GITHUB_URL=https://github.com/weblexai/weblexai-community
WEBLEX_DOCS_URL=https://github.com/weblexai/weblexai-community/tree/main/docs
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC
APP_MAINTENANCE_DRIVER=file
TRANSLATION_API_RATE_LIMIT=120

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30
LOG_VIEWER_ENABLED=true

ERROR_REPORTING_ENABLED=false
ERROR_REPORTING_WEBHOOK_URL=
ERROR_REPORTING_WEBHOOK_SECRET=
ERROR_REPORTING_TELEGRAM_BOT_TOKEN=
ERROR_REPORTING_TELEGRAM_CHAT_ID=
ERROR_REPORTING_TIMEOUT=5
ERROR_REPORTING_THROTTLE_MINUTES=15

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=weblex
DB_USERNAME=weblex
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_PREFIX=weblex_

FILESYSTEM_DISK=public
MEDIA_DISK=public

BACKUP_NAME="${APP_NAME}"
BACKUP_DISK=backups
BACKUP_PATH=/backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAX_AGE_DAYS=7
BACKUP_MAX_STORAGE_MB=5120
BACKUP_NOTIFICATIONS_ENABLED=false
BACKUP_NOTIFICATION_EMAIL=noreply@example.com

HEALTH_HISTORY_DAYS=7
HEALTH_NOTIFICATIONS_ENABLED=false
HEALTH_TO_ADDRESS=
HEALTH_DISK_WARN_THRESHOLD=80
HEALTH_DISK_FAIL_THRESHOLD=90

VITE_APP_NAME="${APP_NAME}"
OCTANE_SERVER=frankenphp
